<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the HTML documentation in Docs/html from doqua.dll, its XML comments and Pages/*.html.
       Run: dotnet run (project Tools/DocGen) from anywhere in the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Sources/Doqua.csproj" />
  </ItemGroup>

</Project>
